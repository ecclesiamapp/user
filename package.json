{
  "name": "ecclesiam-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./tests/register-alias.mjs --test tests/*.test.ts",
    "test:load": "k6 run tests/load/natal-stress-test.js",
    "test:load:smoke": "k6 run -e TEST_MODE=smoke tests/load/natal-stress-test.js",
    "test:load:quick": "k6 run -e TEST_MODE=quick tests/load/natal-stress-test.js",
    "test:load:peak500": "k6 run -e TEST_MODE=peak500 tests/load/natal-stress-test.js",
    "test:load:full": "k6 run -e TEST_MODE=full tests/load/natal-stress-test.js",
    "test:load:clean": "node tests/load/cleanup.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "browser-image-compression": "^2.0.2",
    "lucide-react": "^1.47.0",
    "next": "^16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "^6.2.4",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
